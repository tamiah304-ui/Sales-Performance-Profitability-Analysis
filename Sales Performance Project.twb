      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0143271974146048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Profit])/SUM([Sales_Amount])' />
      </column>
      <column caption='Average Profit Per Sale' datatype='real' name='[Calculation_0143271975555073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Total_Profit])' />
      </column>
      <column caption='Profit highlight' datatype='string' name='[Calculation_0143272066850818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Product_Category] = &quot;Furniture&quot;&#13;&#10;THEN &quot;Furniture&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Sales highlight' datatype='string' name='[Calculation_0143272067407875]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Product_Category] = &quot;Clothing&quot;&#13;&#10;THEN &quot;Clothing&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
